# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# YOUTUBE_API_KEY: Standard developer key to search exercise videos dynamically.
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

# FITBIT_CLIENT_ID: OAuth2 Client ID for Fitbit API cloud integrations.
FITBIT_CLIENT_ID=MY_FITBIT_CLIENT_ID

# GARMIN_CLIENT_KEY: OAuth consumer key or client identity for Garmin Connect.
GARMIN_CLIENT_KEY=MY_GARMIN_CLIENT_KEY
